# Pulled by `vercel env pull` after `vercel link`.
# OIDC tokens expire ~12 hours — re-run `vercel env pull` if live grading auth fails.
# If live AI still fails after Gateway failover, the API falls back to a local keyword grade.
# Production/preview on Vercel provisions OIDC automatically.
VERCEL_OIDC_TOKEN=

# Alternate AI Gateway auth (not used by default — OIDC is preferred for this project)
# AI_GATEWAY_API_KEY=
